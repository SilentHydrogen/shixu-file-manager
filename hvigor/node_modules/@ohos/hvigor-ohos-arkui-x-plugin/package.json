{
  "name": "@ohos/hvigor-ohos-arkui-x-plugin",
  "version": "4.23.7",
  "description": "arkui cross-platform application build plugin",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "tsc --build --clean",
    "prepack": "npm run ugly-build",
    "uglify": "node ../../scripts/uglify.js",
    "coverage": "nyc --clean jest --coverage",
    "ugly-build": "npm run clean && npm run build && npm run uglify && npm run uglifypack",
    "uglifypack": "node ../../scripts/uglifypack.js"
  },
  "main": "./index.js",
  "author": "huawei",
  "ohos": {
    "org": "huawei"
  },
  "engines": {
    "node": ">14.14.0"
  },
  "license": "SEE LICENSE IN LICENSE.txt",
  "type": "commonjs",
  "nyc": {
    "reporter": [
      "lcov",
      "text"
    ],
    "tempDirectory": "./coverage"
  },
  "dependencies": {
    "fs-extra": "11.3.0",
    "uuid": "11.1.0",
    "@baize/wdk": "0.7.2"
  },
  "devDependencies": {
    "@ohos/hvigor-ohos-plugin": "6.23.7",
    "@ohos/hvigor": "6.23.7"
  },
  "overrides": {},
  "peerDependencies": {},
  "keywords": [
    "hvigor",
    "OpenHarmony"
  ],
  "bundleDependencies": [
    "fs-extra",
    "uuid",
    "@baize/wdk"
  ]
}
